<Window x:Class="FireWill.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fire Will"
        AutomationProperties.AutomationId="FireWillMainWindow"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF111316"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#617F8793" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#6B17191D" />

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ColumnHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <Style x:Key="WorkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent" />
                            <Border Grid.Row="1"
                                    Padding="16"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="4">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FarmTaskRowTemplate">
            <Grid Width="644" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="14"
                           Text="{Binding Name}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding NpcAction}" />
                <ComboBox Grid.Column="2"
                          Width="190"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ActionKeyOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Reference"
                          SelectedValue="{Binding ActionReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="选择刷本任务启动使用的技能或装备按键" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReleaseProfileRowTemplate">
            <Grid Width="644" Height="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding Name}" />
                <ComboBox Grid.Column="1"
                          Width="220"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding KeyOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Reference"
                          SelectedValue="{Binding KeyReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="选择该释放方案使用的映射按键" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlowGroupTemplate">
            <Grid Width="1320" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="{Binding Slot}" />
                <CheckBox Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="2"
                          Width="130"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding DataContext.PreTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding PreType, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="166"
                             Style="{StaticResource CompactTextBox}"
                             Text="{Binding PreValue, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource SmallButton}"
                            Content="采"
                            ToolTip="采集组前按键"
                            Click="CaptureGroupPreKey_Click" />
                </StackPanel>
                <ComboBox Grid.Column="4"
                          Width="224"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding DataContext.FarmOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding FarmName, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="5"
                          Width="164"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ReleaseProfileOptions}"
                          SelectedItem="{Binding ReleaseProfileName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="6"
                           VerticalAlignment="Center"
                           Text="{Binding UsedMilliseconds, StringFormat={}{0} ms}" />
                <TextBlock Grid.Column="7"
                           VerticalAlignment="Center"
                           Text="{Binding DurationMilliseconds, StringFormat={}{0} ms}" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="78"
                             Style="{StaticResource CompactTextBox}"
                             Text="{Binding WaitMilliseconds, UpdateSourceTrigger=LostFocus}" />
                    <Button Style="{StaticResource SmallButton}"
                            Content="-"
                            Tag="-10"
                            ToolTip="减少 10 毫秒"
                            Click="AdjustGroupWait_Click" />
                    <Button Style="{StaticResource SmallButton}"
                            Content="+"
                            Tag="10"
                            ToolTip="增加 10 毫秒"
                            Click="AdjustGroupWait_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KeyMapTemplate">
            <Border Width="108"
                    Height="108"
                    Margin="7,6"
                    HorizontalAlignment="Center"
                    Background="#B814171A"
                    BorderBrush="#D6A8782E"
                    BorderThickness="2"
                    CornerRadius="1"
                    SnapsToDevicePixels="True">
                <Grid Margin="4">
                    <Border BorderBrush="#705F4B2B"
                            BorderThickness="1"
                            CornerRadius="1"
                            IsHitTestVisible="False" />
                    <TextBlock Margin="7,5,7,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFD987"
                               Text="{Binding Label}" />
                    <TextBox Width="72"
                             Height="36"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="3,2"
                             FontSize="15"
                             FontWeight="Bold"
                             TextAlignment="Center"
                             Background="#B20B0F12"
                             BorderBrush="#A981693D"
                             CaretBrush="#FFFFE7A6"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Width="30"
                            Height="24"
                            MinHeight="24"
                            Margin="0,0,6,5"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#DD24262A"
                            BorderBrush="#C9B07B31"
                            Content="采"
                            ToolTip="采集按键"
                            Click="CaptureMappedKey_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <MediaElement x:Name="BackgroundVideo"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      IsMuted="True"
                      ScrubbingEnabled="False"
                      Stretch="UniformToFill"
                      IsHitTestVisible="False"
                      MediaEnded="BackgroundVideo_MediaEnded"
                      MediaFailed="BackgroundVideo_MediaFailed" />
        <Border Background="#5C0A0C0F" IsHitTestVisible="False" />

        <Viewbox Stretch="Uniform"
                 StretchDirection="Both"
                 TextElement.Foreground="{StaticResource TextPrimaryBrush}">
            <Grid Width="1400" Height="860" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Left">
                            <TextBlock x:Name="BrandGlowText"
                                       FontFamily="{StaticResource BrandFont}"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFF5A32"
                                       Opacity="0.54"
                                       Text="火之意志">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                                      Color="#FFFF3B1F"
                                                      Direction="0"
                                                      Opacity="0.9"
                                                      ShadowDepth="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="BrandTitleText"
                                       FontFamily="{StaticResource BrandFont}"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       SnapsToDevicePixels="True"
                                       Text="火之意志">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0.5"
                                                         EndPoint="1,0.5"
                                                         MappingMode="RelativeToBoundingBox"
                                                         SpreadMethod="Repeat">
                                        <GradientStop Color="#FFFF5A32" Offset="0" />
                                        <GradientStop Color="#FFFFB52E" Offset="0.16" />
                                        <GradientStop Color="#FFFFF0A6" Offset="0.31" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.43" />
                                        <GradientStop Color="#FFFFD052" Offset="0.53" />
                                        <GradientStop Color="#FFFF6335" Offset="0.68" />
                                        <GradientStop Color="#FFFF3156" Offset="0.82" />
                                        <GradientStop Color="#FFFFB52E" Offset="0.93" />
                                        <GradientStop Color="#FFFF5A32" Offset="1" />
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="BrandFlowTransform" X="-1" />
                                        </LinearGradientBrush.RelativeTransform>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="7"
                                                      Color="#E6000000"
                                                      Direction="270"
                                                      Opacity="0.86"
                                                      ShadowDepth="2" />
                                </TextBlock.Effect>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="BrandFlowTransform"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-1"
                                                                 To="0"
                                                                 Duration="0:0:4.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrandGlowText"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.42"
                                                                 To="0.68"
                                                                 AutoReverse="True"
                                                                 Duration="0:0:1.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </Grid>
                        <TextBlock Margin="2,1,0,0"
                                   FontFamily="{StaticResource MottoFont}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   SnapsToDevicePixels="True"
                                   Text="木叶飞舞之处，火亦生生不息">
                            <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0.5"
                                                         EndPoint="1,0.5"
                                                         MappingMode="RelativeToBoundingBox"
                                                         SpreadMethod="Repeat">
                                    <GradientStop Color="#FFFF8A42" Offset="0" />
                                    <GradientStop Color="#FFFFC94A" Offset="0.16" />
                                    <GradientStop Color="#FFFFF0A2" Offset="0.31" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.43" />
                                    <GradientStop Color="#FFFFD767" Offset="0.53" />
                                    <GradientStop Color="#FFFF7B45" Offset="0.68" />
                                    <GradientStop Color="#FFFF4F5B" Offset="0.82" />
                                    <GradientStop Color="#FFFFC94A" Offset="0.93" />
                                    <GradientStop Color="#FFFF8A42" Offset="1" />
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="MottoFlowTransform" X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="5"
                                                  Color="#CC000000"
                                                  Direction="270"
                                                  Opacity="0.75"
                                                  ShadowDepth="1" />
                            </TextBlock.Effect>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="MottoFlowTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-1"
                                                             To="0"
                                                             Duration="0:0:3.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="动态背景" />
                        <ComboBox x:Name="BackgroundModeComboBox"
                                  Width="132"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectionChanged="BackgroundModeComboBox_SelectionChanged" />
                        <TextBlock Margin="18,0,8,0" VerticalAlignment="Center" Text="透明度" />
                        <Slider x:Name="BackgroundOpacitySlider"
                                Width="150"
                                Minimum="0.05"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                        <TextBlock x:Name="BackgroundOpacityText"
                                   Width="44"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Text="58%" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="当前英雄" />
                        <TextBlock x:Name="CurrentProfileText"
                                   Width="150"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="默认/未读取" />
                        <Button Margin="10,0,0,0" Content="保存配置" Click="SaveProfile_Click" />
                        <Button Margin="8,0,0,0" Content="另存为英雄" Click="SaveProfileAs_Click" />
                        <Button Margin="8,0,0,0" Content="读取配置" Click="LoadProfile_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="GameBindingText"
                                   Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="GameBindingText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="游戏未绑定" />
                        <Button Content="绑定游戏窗口" Click="BindGameWindow_Click" />
                    </StackPanel>
                </Grid>

                <TabControl x:Name="MainTabs"
                            Grid.Row="2"
                            AutomationProperties.AutomationId="MainTabs">
                    <TabItem Header="刷本设置"
                             AutomationProperties.AutomationId="FarmTab"
                             Style="{StaticResource WorkTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Width="1320">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="644" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="644" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="任务启动" />
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="290" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ColumnHeading}" Text="刷本任务" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeading}" Text="任务动作" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeading}" Text="启动按键" />
                                    </Grid>
                                </Grid>
                                <Border Grid.Column="1"
                                        Width="1"
                                        Margin="0,4"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource LineBrush}" />
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="技能释放" />
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ColumnHeading}" Text="组合名称" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeading}" Text="映射按键" />
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1" Width="1320">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="644" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="644" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="FarmItemsControl"
                                              ItemTemplate="{StaticResource FarmTaskRowTemplate}"
                                              ItemsSource="{Binding Farms}" />
                                <Border Grid.Column="1"
                                        Width="1"
                                        Margin="0,0,0,6"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource LineBrush}" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,3,0,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="技能" />
                                    <ItemsControl ItemTemplate="{StaticResource ReleaseProfileRowTemplate}"
                                                  ItemsSource="{Binding SkillReleaseProfiles}" />
                                    <Border Height="1" Margin="0,5,0,5" Background="{StaticResource LineBrush}" />
                                    <TextBlock Margin="0,3,0,2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="装备" />
                                    <ItemsControl ItemTemplate="{StaticResource ReleaseProfileRowTemplate}"
                                                  ItemsSource="{Binding ItemReleaseProfiles}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2"
                                        Margin="0,12,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="清空刷本设置" Click="ClearFarmSettings_Click" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="执行流程" Style="{StaticResource WorkTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="102" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="流程" />
                                <ComboBox x:Name="FlowSelectorComboBox"
                                          Grid.Column="1"
                                          Width="148"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Flows}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="名称" />
                                <TextBox Grid.Column="3"
                                         Margin="0,9"
                                         Text="{Binding SelectedFlow.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Column="4"
                                          VerticalAlignment="Center"
                                          Content="启用"
                                          IsChecked="{Binding SelectedFlow.Enabled}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="126" Text="{Binding SelectedFlow.Hotkey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Style="{StaticResource SmallButton}"
                                            Content="采"
                                            ToolTip="采集流程触发键"
                                            Click="CaptureFlowHotkey_Click" />
                                </StackPanel>
                                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="停止热键" />
                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="StopHotkeyTextBox"
                                             Width="126"
                                             Text="{Binding StopHotkey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Style="{StaticResource SmallButton}"
                                            Content="采"
                                            ToolTip="采集停止热键"
                                            Click="CaptureStopHotkey_Click" />
                                </StackPanel>
                                <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="清空当前流程" Click="ClearCurrentFlow_Click" />
                                    <Button Margin="8,0,0,0" Content="停止" Click="StopMacro_Click" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="普通键耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.KeyDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="KeyDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="KeyDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="技能键耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.SkillKeyDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="SkillKeyDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="SkillKeyDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="F2/F3耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.TeleportKeyDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="TeleportKeyDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="TeleportKeyDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="NPC点击耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.NpcClickDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="NpcClickDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="NpcClickDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="公屏耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.ChatDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="ChatDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="ChatDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="F1耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.HeroSelectDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="HeroSelectDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="HeroSelectDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Width="104" VerticalAlignment="Center" Text="NPC移鼠耗时" />
                                    <TextBox Width="62" Text="{Binding SelectedFlow.MouseMoveDelayMilliseconds}" />
                                    <Button Style="{StaticResource SmallButton}" Content="-" Tag="MouseMoveDelayMilliseconds,-10" Click="AdjustFlowDelay_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="+" Tag="MouseMoveDelayMilliseconds,10" Click="AdjustFlowDelay_Click" />
                                </StackPanel>
                            </UniformGrid>

                            <Grid Grid.Row="2" Width="1320">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeading}" Text="ID" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeading}" Text="启用" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeading}" Text="组前类型" />
                                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeading}" Text="组前按键 / 公屏" />
                                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeading}" Text="刷本任务" />
                                <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeading}" Text="技能释放" />
                                <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeading}" Text="动作占用" />
                                <TextBlock Grid.Column="7" Style="{StaticResource ColumnHeading}" Text="组合时长" />
                                <TextBlock Grid.Column="8" Style="{StaticResource ColumnHeading}" Text="等待 ms" />
                            </Grid>
                            <ItemsControl Grid.Row="3"
                                          ItemTemplate="{StaticResource FlowGroupTemplate}"
                                          ItemsSource="{Binding SelectedFlow.Groups}" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="NPC 与平台按键"
                             AutomationProperties.AutomationId="NpcTab"
                             Style="{StaticResource WorkTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="116" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="NPC" />
                                 <ComboBox Grid.Column="1"
                                           Width="250"
                                           HorizontalAlignment="Left"
                                           AutomationProperties.AutomationId="NpcSelector"
                                           ItemsSource="{Binding Npcs}"
                                           DisplayMemberPath="Name"
                                           SelectedItem="{Binding SelectedNpc, Mode=TwoWay}" />
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Width="112"
                                            Content="记录 NPC 点"
                                            Click="CaptureNpcPoint_Click" />
                                    <TextBlock Width="174"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="↓ 切换 NPC · F6 记录"
                                               Text="↓ 切换 NPC · F6 记录" />
                                </StackPanel>
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="SkipGameCheckCheckBox"
                                              Margin="0,0,16,0"
                                              AutomationProperties.AutomationId="SkipGameCheck"
                                              Content="跳过窗口检测"
                                              IsChecked="{Binding SkipGameCheck}" />
                                    <Button Content="复制当前窗口" Click="CopyWindowInfo_Click" />
                                    <Button Margin="8,0,0,0" Content="清空本区" Click="ClearNpcSettings_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="{StaticResource LineBrush}" />
                            <Grid Grid.Row="2"
                                  Width="780"
                                  Margin="0,20,0,0"
                                  HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="494" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeading}" Text="装备按键" />
                                    <ItemsControl ItemsSource="{Binding ItemMappings}"
                                                  ItemTemplate="{StaticResource KeyMapTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionHeading}" Text="技能按键" />
                                    <ItemsControl ItemsSource="{Binding SkillMappingsForDisplay}"
                                                  ItemTemplate="{StaticResource KeyMapTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                     <TextBlock x:Name="MacroStateText"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="MacroState"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="宏已启用" />
                     <TextBlock x:Name="StatusText"
                                Grid.Column="1"
                                Margin="18,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="StatusText"
                               TextTrimming="CharacterEllipsis"
                               Text="正在启动..." />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="v0.1.9" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
