{
  "name": "fire-will-portable",
  "version": "0.1.6",
  "description": "Fire Will portable Warcraft III workflow companion",
  "author": "Fire Will",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "36.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.firewill.jiban",
    "productName": "Fire Will",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ui",
        "to": "ui"
      },
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../icon.ico"
    }
  }
}
